# HTTPS 入口：压缩响应并转发到本地 Node 服务。
# HTTPS entry point: compress responses and proxy them to the local Node service.
renjiahang1201.xyz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	reverse_proxy app:8787
}
