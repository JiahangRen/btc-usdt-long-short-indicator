# Create a private .env on the server. Never commit the real values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
ALERT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Optional separate key for API-center settings. If omitted, ALERT_ENCRYPTION_KEY
# is used; never commit either key and rotate through your secret manager.
API_CREDENTIAL_ENCRYPTION_KEY=replace-with-another-32-byte-base64-key
# Optional: enables Finnhub economic-calendar consensus / actual / previous fields.
# Keep this server-side; it is never sent to the browser.
FINNHUB_API_KEY=replace-with-your-finnhub-api-key
# Optional: free EIA API key for complete U.S. petroleum actuals/history.
# The calendar's EIA release schedule remains available without it.
EIA_API_KEY=replace-with-your-eia-api-key
# Optional: CoinGecko Demo API key for higher-rate market-context requests.
COINGECKO_API_KEY=replace-with-your-coingecko-demo-api-key
